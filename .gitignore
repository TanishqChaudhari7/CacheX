# Build output -- never committed. Anyone can regenerate it from CMakeLists.txt,
# and committed build artifacts go stale the moment someone changes a flag.
build/
build-*/
cmake-build-*/
out/

# Generated by CMAKE_EXPORT_COMPILE_COMMANDS; machine-specific absolute paths.
compile_commands.json

# Editors / IDEs / local tooling
.claude/settings.local.json

# Personal editor settings stay out, but the C++ configuration is shared: it is
# what makes IntelliSense agree with the build about the language standard.
.vscode/*
!.vscode/c_cpp_properties.json
.idea/
*.swp
*~

# macOS
.DS_Store

# Compiled objects and binaries, in case anything is built outside build/
*.o
*.a
*.so
*.dylib
